                  "// พญ.มนัสนันท์ ออกตรวจวันเสาร์แบบ walk-in อย่างเดียว (accepts_booking = false)",
                  "pm.test('เวรที่ไม่รับนัดล่วงหน้าถูกกันไว้', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('SCHEDULE_NOT_BOOKABLE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "วันที่แพทย์ลา → DOCTOR_ON_LEAVE",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Staff-Id", "value": "{{staffId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{ptNattapon}}\",\n  \"doctorId\": \"{{drAnan}}\",\n  \"typeCode\": \"FOLLOW_UP\",\n  \"startsAt\": \"{{leaveDate}}T10:00:00+07:00\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ไม่ให้จองในวันที่แพทย์ลา', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('DOCTOR_ON_LEAVE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "คนไข้จองซ้อนตัวเอง → PATIENT_DOUBLE_BOOKED",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Staff-Id", "value": "{{staffId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{ptNattapon}}\",\n  \"doctorId\": \"{{drAnan}}\",\n  \"typeCode\": \"FOLLOW_UP\",\n  \"startsAt\": \"{{date}}T10:15:00+07:00\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// คนไข้คนเดียวกันอยู่สองที่พร้อมกันไม่ได้ แม้จะเป็นคนละแพทย์คนละแผนก",
                  "pm.test('กันคนไข้จองซ้อนเวลาตัวเอง', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
                  "  pm.expect(pm.response.json().error.code).to.eql('PATIENT_DOUBLE_BOOKED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 — Cancellation (โจทย์ข้อ 7)",
      "item": [
        {
          "name": "ยกเลิกนัด",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Staff-Id", "value": "{{staffId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"ผู้ป่วยติดภารกิจ ขอเลื่อนนัด\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{appointmentId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ยกเลิกสำเร็จ', () => pm.response.to.have.status(200));",
                  "",
                  "const a = pm.response.json().data;",
                  "pm.test('บันทึกเหตุผล ผู้ยกเลิก และเวลาครบถ้วน', () => {",
                  "  pm.expect(a.status).to.eql('cancelled');",
                  "  pm.expect(a.cancellationReason).to.be.a('string').that.is.not.empty;",
                  "  pm.expect(a.cancelledBy).to.not.be.null;",
                  "  pm.expect(a.cancelledAt).to.not.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "slot กลับมาว่างอีกครั้ง",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{drAnan}}/availability?date={{date}}&typeCode=FOLLOW_UP",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{drAnan}}", "availability"],
              "query": [
                { "key": "date", "value": "{{date}}" },
                { "key": "typeCode", "value": "FOLLOW_UP" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('14:00 กลับมาจองได้แล้วหลังยกเลิก', () => {",
                  "  const slots = pm.response.json().data.slots.map(s => s.startsAt.slice(11, 16));",
                  "  pm.expect(slots).to.include('14:00');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "ยกเลิกซ้ำ → INVALID_STATUS_TRANSITION",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Staff-Id", "value": "{{staffId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"ยกเลิกซ้ำ\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{appointmentId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('state machine กันการเปลี่ยนสถานะที่ไม่ถูกต้อง', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error.code).to.eql('INVALID_STATUS_TRANSITION');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "ยกเลิกโดยไม่ระบุเหตุผล → VALIDATION_ERROR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Staff-Id", "value": "{{staffId}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{appointmentId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "appointments", "{{appointmentId}}", "cancel"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('บังคับให้ระบุเหตุผลการยกเลิก', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 — Idempotency",
      "item": [
        {
          "name": "จองครั้งแรกด้วย Idempotency-Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Staff-Id", "value": "{{staffId}}" },
              { "key": "Idempotency-Key", "value": "99999999-dddd-4eee-8fff-000000000042" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{ptNattapon}}\",\n  \"doctorId\": \"{{drPiyada}}\",\n  \"typeCode\": \"CONSULTATION\",\n  \"startsAt\": \"{{date}}T15:00:00+07:00\",\n  \"reason\": \"ทดสอบ idempotency\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('สร้างนัดใหม่สำเร็จ', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('idemAppointmentId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "ยิงซ้ำด้วย key เดิม → ต้องได้ใบเดิม ไม่สร้างซ้ำ",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Staff-Id", "value": "{{staffId}}" },
              { "key": "Idempotency-Key", "value": "99999999-dddd-4eee-8fff-000000000042" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": \"{{ptNattapon}}\",\n  \"doctorId\": \"{{drPiyada}}\",\n  \"typeCode\": \"CONSULTATION\",\n  \"startsAt\": \"{{date}}T15:00:00+07:00\",\n  \"reason\": \"ทดสอบ idempotency\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/appointments", "host": ["{{baseUrl}}"], "path": ["api", "appointments"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('คืน 200 ไม่ใช่ 409 (retry ต้องปลอดภัย)', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('เป็นนัดใบเดิม ไม่ได้สร้างใหม่', () => {",
                  "  pm.expect(pm.response.json().data.id)",
                  "    .to.eql(pm.collectionVariables.get('idemAppointmentId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
