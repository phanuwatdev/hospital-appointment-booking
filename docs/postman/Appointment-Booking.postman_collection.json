      "name": "02 — Happy path",
      "item": [
        {
          "name": "หา slot ว่าง (FOLLOW_UP 15 นาที)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/doctors/{{drAnan}}/availability?date={{date}}&typeCode=FOLLOW_UP",
              "host": ["{{baseUrl}}"],
              "path": ["api", "doctors", "{{drAnan}}", "availability"],
              "query": [
                { "key": "date", "value": "{{date}}" },
                { "key": "typeCode", "value": "FOLLOW_UP" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const slots = pm.response.json().data.slots.map(s => s.startsAt.slice(11, 16));",
                  "",
                  "pm.test('มี slot ว่างให้เลือก', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(slots).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test('ไม่แสดง slot ที่ถูกจองไปแล้ว (09:00)', () => {",
                  "  pm.expect(slots).to.not.include('09:00');",
                  "});",
                  "",
                  "pm.test('ไม่แสดง slot ในเวลาพักกลางวัน (12:00–13:00)', () => {",
                  "  ['12:00','12:15','12:30','12:45'].forEach(t =>",
                  "    pm.expect(slots).to.not.include(t));",
                  "});",
                  "",
                  "pm.test('ไม่แสดง slot ที่ทับช่วง buffer ของหัตถการ (11:30, 11:35)', () => {",
                  "  pm.expect(slots).to.not.include('11:30');",
                  "});",
                  "",
                  "pm.test('ไม่แสดง slot ที่จะล้นเวลาเลิกงาน (15:45 + 15 นาที = 16:00 พอดี จึงต้องมี)', () => {",
                  "  pm.expect(slots).to.include('15:45');",
                  "  pm.expect(slots).to.not.include('16:00');",
                  "});"
                ]
              }
            }
          ]
