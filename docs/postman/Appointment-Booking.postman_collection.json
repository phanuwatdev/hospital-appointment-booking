{
  "info": {
    "name": "Appointment Booking Module",
    "description": "Take-home test — Hospital Information System.\n\nกด Run collection ได้เลย ทุกคำขอมี test assertion ในตัว\nโฟลเดอร์ 03 ตรงกับกฎการป้องกันการจองผิดในโจทย์ข้อ 5 ทีละข้อ\n\nวันที่ของนัดคำนวณอัตโนมัติเป็น 'วันจันทร์ถัดไป' ให้ตรงกับ db/seed.sql\nจึงไม่ต้องแก้วันที่เองไม่ว่าจะรันวันไหน",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// คำนวณวันจันทร์ถัดไป ให้ตรงกับข้อมูลใน db/seed.sql",
          "const d = new Date();",
          "const shift = ((8 - (d.getDay() === 0 ? 7 : d.getDay())) % 7) || 7;",
          "d.setDate(d.getDate() + shift);",
          "const pad = n => String(n).padStart(2, '0');",
          "const iso = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
          "pm.collectionVariables.set('date', iso);",
          "",
          "// วันพุธ = วันที่แพทย์ D001 ลาพักร้อนตาม seed",
          "const w = new Date(d); w.setDate(w.getDate() + 2);",
          "pm.collectionVariables.set('leaveDate', `${w.getFullYear()}-${pad(w.getMonth() + 1)}-${pad(w.getDate())}`);",
          "",
          "// วันเสาร์ = เวร walk-in ของ D004 ที่ accepts_booking = false ตาม seed",
          "const sat = new Date(d); sat.setDate(sat.getDate() + 5);",
          "pm.collectionVariables.set('saturday', `${sat.getFullYear()}-${pad(sat.getMonth() + 1)}-${pad(sat.getDate())}`);"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "staffId", "value": "44444444-4444-4444-4444-444444444401" },
    { "key": "drAnan", "value": "22222222-2222-2222-2222-222222222201" },
    { "key": "drPiyada", "value": "22222222-2222-2222-2222-222222222202" },
    { "key": "drThanawat", "value": "22222222-2222-2222-2222-222222222203" },
    { "key": "drManatnan", "value": "22222222-2222-2222-2222-222222222204" },
    { "key": "ptWichai", "value": "33333333-3333-3333-3333-333333333301" },
    { "key": "ptNattapon", "value": "33333333-3333-3333-3333-333333333303" },
    { "key": "date", "value": "" },
    { "key": "leaveDate", "value": "" },
    { "key": "saturday", "value": "" },
    { "key": "appointmentId", "value": "" }
  ],
